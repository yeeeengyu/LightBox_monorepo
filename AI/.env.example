# Flask BE base URL, reachable from this AI process/container.
AUTH_SERVICE_URL=http://127.0.0.1:8000
AUTH_SERVICE_TIMEOUT_SECONDS=5

# Unset MODEL_PATH uses AI/models/best.pt.
# MODEL_PATH=./models/best.pt
CONF_THRES=0.30
IMGSZ=480
EAR_THRESH=0.19
EAR_THRESH_PHONE=0.095
EAR_THRESH_MOBILE=0.095

# Add the deployed frontend origin if it differs from these defaults.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://spoti.ingyuc.click
