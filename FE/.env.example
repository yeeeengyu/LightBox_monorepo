# Vite development proxy: browser /auth requests go to the Flask BE.
AUTH_PROXY_TARGET=http://localhost:8000

# Empty or / keeps auth requests on the frontend origin in all environments.
# Override only when the browser should call a separate BE origin directly.
VITE_API_BASE_URL=

# Unset: development uses the frontend hostname on port 8001;
# production uses wss://spoti.ingyuc.click.
# VITE_DROWSINESS_WS_URL=ws://localhost:8001/ws/keypoints
# VITE_YAWN_WS_URL=ws://localhost:8001/ws/yawn
VITE_YAWN_FRAME_INTERVAL_MS=1500
